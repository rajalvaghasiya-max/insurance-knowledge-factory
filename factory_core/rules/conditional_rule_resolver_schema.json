{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PolicyScna Authoritative Conditional Rule Artifact - Resolver Boundary",
  "type": "object",
  "required": [
    "schema_version",
    "entity_id",
    "field",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "authority_mode": {
      "enum": ["authoritative", "authoritative_conditional_rules"]
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "field": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "concept_id",
          "rule_type",
          "effect",
          "applies_when",
          "coverage_scope",
          "evidence",
          "status"
        ]
      }
    }
  },
  "additionalProperties": true
}
